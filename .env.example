# Public origins
FRONTEND_ORIGIN=https://app.example.com
# Only set this if FRONTEND_ORIGIN is left empty/"*" AND you understand that
# it lets any website send credentialed requests using a logged-in user's
# session cookie. Leave unset in production; prefer an explicit FRONTEND_ORIGIN.
ALLOW_ANY_ORIGIN_WITH_CREDENTIALS=

# Generate independent random values for production. Never commit the real .env.
APP_ACCESS_TOKEN=replace-with-a-long-random-secret
APP_CSRF_TOKEN=replace-with-a-different-random-secret
WORKER_API_TOKEN=replace-with-another-random-secret
API_RATE_LIMIT_PER_MINUTE=180
# Set to the exact trusted reverse-proxy hop count; leave empty for direct access.
TRUST_PROXY_HOPS=
MARKET_CACHE_TTL_SECONDS=120
AUTH_REQUIRED=true
SESSION_HOURS=168
ADMIN_EMAILS=admin@example.com

# Gemini stays server-side
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_ENABLED=true
GEMINI_TIMEOUT_MS=12000
GEMINI_DAILY_MESSAGE_LIMIT=100
GEMINI_DAILY_BUDGET_USD=0
# Set this from your current provider pricing. Zero keeps cost estimates disabled.
GEMINI_ESTIMATED_USD_PER_MILLION_TOKENS=0

# Background services
WORKER_POLL_MS=60000
BACKUP_INTERVAL_MS=86400000
BACKUP_RETENTION_COUNT=14

# Official Path of Exile OAuth
POE_OAUTH_CLIENT_ID=
POE_OAUTH_CLIENT_SECRET=
POE_OAUTH_REDIRECT_URI=
POE_OAUTH_TOKEN_ENCRYPTION_KEY=
