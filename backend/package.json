{
  "name": "poe2-orb-analyzer-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "backup-worker": "tsx src/backupWorker.ts",
    "db:backup": "tsx src/databaseMaintenance.ts backup",
    "db:verify": "tsx src/databaseMaintenance.ts verify",
    "db:restore": "tsx src/databaseMaintenance.ts restore",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run && tsx --test src/app.integration.ts"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "poe2-orb-analyzer-shared-types": "^1.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
